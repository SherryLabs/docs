{
  "$schema": "https://mintlify.com/docs.json",
  "llms": true,
  "theme": "mint",
  "name": "Relayer.fi",
  "colors": {
    "primary": "#2C8C99",
    "light": "#38BFC2",
    "dark": "#38BFC2"
  },
  "favicon": "/images/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "get-started/overview",
              "get-started/authentication",
              "get-started/quickstart",
              "get-started/ai-assistants",
              "get-started/changelog"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "shared/architecture",
              "shared/auth-model",
              "shared/glossary",
              "shared/error-reference"
            ]
          }
        ]
      },
      {
        "tab": "Signing Kit",
        "groups": [
          {
            "group": "Signing Kit",
            "pages": [
              "signing/overview",
              "signing/flow-guide",
              "signing/endpoints"
            ]
          }
        ]
      },
      {
        "tab": "Payout Kit",
        "groups": [
          {
            "group": "Payout Kit",
            "pages": [
              "payout/overview",
              "payout/flow-guide",
              "payout/endpoints"
            ]
          }
        ]
      },
      {
        "tab": "Agent Kit",
        "groups": [
          {
            "group": "Agent Kit",
            "pages": [
              "agent/overview",
              "agent/getting-started",
              "agent/flow-guide",
              "agent/sdk",
              "agent/endpoints"
            ]
          }
        ]
      },
      {
        "tab": "Widget Kit",
