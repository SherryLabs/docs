          {
            "group": "Widget Kit",
            "pages": [
              "widget/overview",
              "widget/installation",
              "widget/integration",
              "widget/sdk"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Wallets",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "tag": "Wallets"
            }
          },
          {
            "group": "Addresses",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "tag": "Addresses"
            }
          },
          {
            "group": "Transactions",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "api-reference/flows/transaction-signing",
