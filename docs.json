{
  "$schema": "https://mintlify.com/docs.json",
  "llms": true,
  "theme": "mint",
  "name": "Relayer.fi",
  "colors": {
    "primary": "#015F51",
    "light": "#ECE6D6",
    "dark": "#015F51"
  },
  "fonts": {
    "family": "Archivo"
  },
  "background": {
    "color": {
      "light": "#F6F6F4",
      "dark": "#1A1A19"
    }
  },
  "favicon": {
    "light": "/images/relayer-isotype-petrol.svg",
    "dark": "/images/relayer-isotype-cream.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "get-started/overview",
              "get-started/authentication",
              "get-started/quickstart",
              "get-started/sdks",
              "get-started/ai-assistants",
              "get-started/changelog"
            ]
          },
          {
            "group": "Foundations",
            "pages": [
              "shared/architecture",
              "shared/auth-model",
              "shared/glossary",
              "shared/error-reference"
            ]
          }
        ]
      },
      {
        "tab": "Signing Kit",
        "groups": [
          {
            "group": "Signing Kit",
            "pages": [
              "signing/overview",
              "signing/flow-guide",
              "signing/endpoints"
            ]
          }
        ]
      },
      {
        "tab": "Payout Kit",
        "groups": [
          {
            "group": "Payout Kit",
            "pages": [
              "payout/overview",
              "payout/flow-guide",
              "payout/endpoints"
            ]
          }
        ]
      },
      {
        "tab": "Agent Kit",
        "groups": [
          {
            "group": "Agent Kit",
            "pages": [
              "agent/overview",
              "agent/getting-started",
              "agent/flow-guide",
              "agent/sdk",
              "agent/endpoints"
            ]
          }
        ]
      },
      {
        "tab": "Widget Kit",
        "groups": [
          {
            "group": "Widget Kit",
            "pages": [
              "widget/overview",
              "widget/installation",
              "widget/integration",
              "widget/sdk"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Wallets",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "tag": "Wallets"
            }
          },
          {
            "group": "Addresses",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "tag": "Addresses"
            }
          },
          {
            "group": "Transactions",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "GET /transactions/pending-signature",
              "GET /transactions/sign",
              "GET /transactions/sign/{transactionId}",
              "DELETE /transactions/sign/{transactionId}",
              "POST /transactions/broadcast/{transactionId}",
              "POST /transactions/broadcast/raw",
              "GET /transactions/broadcast/{transactionId}",
              "POST /transactions/broadcast/{transactionId}/retry"
            ]
          },
          {
            "group": "Widget Actions",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "api-reference/flows/actions-intro",
              "POST /action/builders/swap",
              "POST /action/builders/transfer-native",
              "POST /action/builders/crosschain-transfer",
              "POST /action/builders/crosschain-bridge",
              "GET /action/directory",
              "GET /action/tokens/{chain}/{protocol}"
            ]
          },
          {
            "group": "Agents",
            "openapi": "api-reference/openapi.json",
            "pages": [
              {
                "group": "Operator (api-key)",
                "pages": [
                  "GET /agents",
                  "GET /agents/{id}",
                  "POST /agents/{id}/pause",
                  "POST /agents/{id}/resume"
                ]
              },
              {
                "group": "Runtime (HMAC)",
                "pages": [
                  "GET /agents/{id}/status",
                  "GET /agents/{id}/balance",
                  "GET /agents/{id}/budget",
                  "POST /agents/{id}/sign-transaction",
                  "POST /agents/events/batch",
                  "api-reference/flows/agent-x402-pay"
                ]
              }
            ]
          },
          {
            "group": "Beneficiaries",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "tag": "Payout: Recipients"
            }
          },
          {
            "group": "Global Payout",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "api-reference/flows/payout-setup",
              "api-reference/flows/payout-virtual-account",
              "POST /payout/accounts/quote",
              "POST /payout/accounts/execute",
              "GET /payout/accounts",
              "GET /payout/accounts/{reference}/status"
            ]
          },
          {
            "group": "On-ramp",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "POST /payout/onramp/quote",
              "POST /payout/onramp/deposit-accounts",
              "GET /payout/onramp/deposit-accounts",
              "GET /payout/onramp/deposit-accounts/{id}",
              "GET /payout/onramp/deposit-accounts/{id}/events"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://relayer.fi",
          "icon": "globe"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/relayerfi",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/relayer-isotype-petrol.svg",
    "dark": "/images/relayer-isotype-cream.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:dev@relayer.fi"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/RelayerProtocol",
      "github": "https://github.com/relayerfi"
    }
  },
  "redirects": [
    { "source": "/quickstart", "destination": "/get-started/quickstart" },
    { "source": "/development", "destination": "/get-started/overview" },
    { "source": "/exchange/:slug*", "destination": "/get-started/overview" },
    { "source": "/action/:slug*", "destination": "/widget/overview" },
    { "source": "/essentials/settings", "destination": "/get-started/overview" },
    { "source": "/essentials/navigation", "destination": "/get-started/overview" },
    { "source": "/essentials/markdown", "destination": "/get-started/overview" },
    { "source": "/essentials/code", "destination": "/get-started/overview" },
    { "source": "/essentials/images", "destination": "/get-started/overview" },
    { "source": "/essentials/reusable-snippets", "destination": "/get-started/overview" },
    { "source": "/ai-tools/claude-code", "destination": "/get-started/overview" },
    { "source": "/ai-tools/cursor", "destination": "/get-started/overview" },
    { "source": "/ai-tools/windsurf", "destination": "/get-started/overview" }
  ],
  "appearance": {
    "default": "system"
  }
}
