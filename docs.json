              },
              {
                "group": "Read",
                "pages": [
                  "GET /agents",
                  "GET /agents/{id}",
                  "GET /agents/{id}/wallet",
                  "GET /agents/{id}/wallet-balance",
                  "GET /agents/{id}/budget",
                  "GET /agents/analytics/summary",
                  "GET /agents/{id}/analytics",
                  "GET /agents/{id}/audit",
                  "GET /agents/approvals"
                ]
              },
              {
                "group": "Control",
                "pages": [
                  "POST /agents/{id}/budget",
                  "POST /agents/{id}/kill",
                  "POST /agents/{id}/pause",
                  "POST /agents/{id}/resume",
                  "POST /agents/{id}/rotate",
                  "PATCH /agents/{id}/status"
                ]
              },
              {
                "group": "Funding",
                "pages": [
                  "POST /agents/{id}/fund/prepare",
                  "POST /agents/{id}/fund/confirm"
                ]
              },
              {
                "group": "Runtime (HMAC)",
                "pages": [
                  "POST /agents/wallets",
                  "POST /agents/{id}/sign-transaction",
                  "api-reference/flows/agent-x402-pay",
                  "POST /agents/events/batch"
                ]
              },
              {
                "group": "Tools",
                "pages": [
                  "GET /agents/{id}/tools",
                  "POST /agents/{id}/tools",
                  "DELETE /agents/{id}/tools/{toolId}"
                ]
              }
            ]
          },
          {
            "group": "Skills",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "tag": "Skills"
            }
          },
          {
            "group": "Widgets",
            "pages": [
              {
                "group": "Builders",
                "openapi": {
                  "source": "api-reference/openapi.json",
                  "directory": "api-reference",
                  "tag": "Action: Builders"
                }
              },
              {
                "group": "Execute",
                "openapi": {
                  "source": "api-reference/openapi.json",
                  "directory": "api-reference",
                  "tag": "Action: Execute"
                }
              },
              {
                "group": "Quote",
                "openapi": {
                  "source": "api-reference/openapi.json",
                  "directory": "api-reference",
                  "tag": "Action: Quote (Public)"
                }
              },
              {
                "group": "Directory",
                "openapi": {
                  "source": "api-reference/openapi.json",
                  "directory": "api-reference",
                  "tag": "Action: Directory"
                }
              },
              {
                "group": "Tokens",
                "openapi": {
                  "source": "api-reference/openapi.json",
                  "directory": "api-reference",
                  "tag": "Action: Tokens"
                }
              }
            ]
          },
          {
            "group": "Payouts",
            "pages": [
              {
                "group": "Accounts",
