            "openapi": "api-reference/openapi.json",
            "pages": [
              {
                "group": "Lifecycle",
                "pages": [
                  "api-reference/flows/agent-provisioning",
                  "POST /agents/confirm-user",
                  "api-reference/flows/agent-finalize",
                  "POST /agents/{id}/prepare-policies",
                  "DELETE /agents/{id}"
