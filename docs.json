          {
            "group": "Recipients",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "tag": "Payout: Recipients"
            }
          },
          {
            "group": "Orders",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "tag": "Payout: Orders"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://relayer.fi",
          "icon": "globe"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/relayerfi",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/Relayer-darklogo-coloriso.png",
    "dark": "/images/Relayer-whitelogo-coloriso.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@relayer.fi"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/RelayerProtocol",
      "github": "https://github.com/relayerfi"
    }
  },
  "redirects": [
    { "source": "/quickstart", "destination": "/get-started/quickstart" },
    { "source": "/development", "destination": "/get-started/overview" },
    { "source": "/exchange/:slug*", "destination": "/get-started/overview" },
    { "source": "/action/:slug*", "destination": "/widget/overview" },
    { "source": "/essentials/settings", "destination": "/get-started/overview" },
    { "source": "/essentials/navigation", "destination": "/get-started/overview" },
    { "source": "/essentials/markdown", "destination": "/get-started/overview" },
    { "source": "/essentials/code", "destination": "/get-started/overview" },
    { "source": "/essentials/images", "destination": "/get-started/overview" },
    { "source": "/essentials/reusable-snippets", "destination": "/get-started/overview" },
    { "source": "/ai-tools/claude-code", "destination": "/get-started/overview" },
    { "source": "/ai-tools/cursor", "destination": "/get-started/overview" },
    { "source": "/ai-tools/windsurf", "destination": "/get-started/overview" }
  ],
  "appearance": {
    "default": "system"
  }
}
